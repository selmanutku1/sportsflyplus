{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public non-PII user identity and role metadata for club members.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "clubName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "role": {
          "type": "string",
          "enum": ["kulup_yoneticisi", "egitmen", "veli", "sporcu"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "clubName", "role", "createdAt", "updatedAt"]
    },
    "UserPrivatePII": {
      "title": "UserPrivatePII",
      "description": "Strictly isolated KVKK PII data accessible only by the document owner or verified admin.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "maskedTcKimlik": {
          "type": "string",
          "maxLength": 20
        },
        "kvkkConsentAccepted": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "email", "phone", "kvkkConsentAccepted", "updatedAt"]
    },
    "AthleteLabReport": {
      "title": "AthleteLabReport",
      "description": "SportsFly Lab 7-page athlete biometric and motor performance report card.",
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "athleteCode": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "athleteName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "sportBranch": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "overallScore": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["reportId", "ownerId", "athleteCode", "athleteName", "sportBranch", "overallScore", "createdAt", "updatedAt"]
    },
    "PaymentIntent": {
      "title": "PaymentIntent",
      "description": "PCI-DSS SAQ-A tokenized payment intent record. Never stores raw PAN or CVV.",
      "type": "object",
      "properties": {
        "intentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "planId": {
          "type": "string",
          "enum": ["baslangic-kulubu", "kulup-akademi", "pro-akademi-coklu-sube"]
        },
        "billingCycle": {
          "type": "string",
          "enum": ["aylik", "yillik"]
        },
        "amountTry": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["TRY"]
        },
        "status": {
          "type": "string",
          "enum": ["requires_3ds_authorization", "succeeded", "cancelled", "refunded"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["intentId", "ownerId", "idempotencyKey", "planId", "billingCycle", "amountTry", "currency", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public user profile isolated from PII."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivatePII" },
      "description": "Strict KVKK PII subcollection accessible only by the owner or verified admin."
    },
    "/labReports/{reportId}": {
      "schema": { "$ref": "#/entities/AthleteLabReport" },
      "description": "SportsFly Lab biometric and motor performance reports."
    },
    "/paymentIntents/{intentId}": {
      "schema": { "$ref": "#/entities/PaymentIntent" },
      "description": "PCI-DSS SAQ-A tokenized payment intents with terminal state locking."
    }
  }
}
