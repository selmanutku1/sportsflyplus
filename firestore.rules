rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. GLOBAL SAFETY NET (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. HARDENED PRIMITIVES
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'selmanutkumarmara@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. VALIDATION BLUEPRINTS (Anti-Update-Gap & Strict Schema Enforcement)
    function isValidUserPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'clubName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'clubName', 'role', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
        data.clubName is string && data.clubName.size() >= 2 && data.clubName.size() <= 140 &&
        data.role is string && data.role in ['kulup_yoneticisi', 'egitmen', 'veli', 'sporcu'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivatePII(data) {
      return data.keys().hasAll(['ownerId', 'email', 'phone', 'kvkkConsentAccepted', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'email', 'phone', 'maskedTcKimlik', 'kvkkConsentAccepted', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 32 &&
        (!('maskedTcKimlik' in data) || (data.maskedTcKimlik is string && data.maskedTcKimlik.size() <= 20)) &&
        data.kvkkConsentAccepted is bool && data.kvkkConsentAccepted == true &&
        data.updatedAt is timestamp;
    }

    function isValidAthleteLabReport(data) {
      return data.keys().hasAll(['reportId', 'ownerId', 'athleteCode', 'athleteName', 'sportBranch', 'overallScore', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['reportId', 'ownerId', 'athleteCode', 'athleteName', 'sportBranch', 'overallScore', 'createdAt', 'updatedAt']) &&
        isValidId(data.reportId) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.athleteCode) && data.athleteCode.size() <= 64 &&
        data.athleteName is string && data.athleteName.size() >= 2 && data.athleteName.size() <= 120 &&
        data.sportBranch is string && data.sportBranch.size() >= 2 && data.sportBranch.size() <= 80 &&
        data.overallScore is number && data.overallScore >= 0 && data.overallScore <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPaymentIntent(data) {
      return data.keys().hasAll(['intentId', 'ownerId', 'idempotencyKey', 'planId', 'billingCycle', 'amountTry', 'currency', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['intentId', 'ownerId', 'idempotencyKey', 'planId', 'billingCycle', 'amountTry', 'currency', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.intentId) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.idempotencyKey) && data.idempotencyKey.size() >= 8 &&
        data.planId is string && data.planId in ['baslangic-kulubu', 'kulup-akademi', 'pro-akademi-coklu-sube'] &&
        data.billingCycle is string && data.billingCycle in ['aylik', 'yillik'] &&
        data.amountTry is number && data.amountTry > 0 && data.amountTry <= 500000 &&
        data.currency is string && data.currency == 'TRY' &&
        data.status is string && data.status in ['requires_3ds_authorization', 'succeeded', 'cancelled', 'refunded'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. COLLECTION RULES
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidUserPublicProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserPublicProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (request.auth.uid == userId &&
           incoming().role == existing().role &&
           incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'clubName', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(userId);

      // Split Collection PII Isolation
      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(docId) &&
          (request.auth.uid == userId || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if false;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          userId == request.auth.uid &&
          isValidUserPrivatePII(incoming()) &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidUserPrivatePII(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId)) && (
            isAdmin() ||
            (request.auth.uid == userId &&
             incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'maskedTcKimlik', 'updatedAt']))
          );

        allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
      }
    }

    match /labReports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(reportId) &&
        incoming().reportId == reportId &&
        isValidAthleteLabReport(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(reportId) &&
        isValidAthleteLabReport(incoming()) &&
        incoming().reportId == existing().reportId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (resource.data.ownerId == request.auth.uid &&
           incoming().diff(existing()).affectedKeys().hasOnly(['athleteName', 'sportBranch', 'overallScore', 'updatedAt']))
        );

      allow delete: if isSignedIn() && isValidId(reportId) && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Payment Intents: Strict PCI-DSS SAQ-A & Terminal State Locking
    match /paymentIntents/{intentId} {
      allow get: if isSignedIn() && isValidId(intentId) && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      // Clients can only initialize an intent in 'requires_3ds_authorization' state
      allow create: if isVerifiedUser() &&
        isValidId(intentId) &&
        incoming().intentId == intentId &&
        isValidPaymentIntent(incoming()) &&
        incoming().status == 'requires_3ds_authorization' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      // Terminal State Lock: Once status is 'succeeded', 'cancelled', or 'refunded', clients CANNOT modify it.
      // Clients can only cancel a pending 'requires_3ds_authorization' intent; only verified Admin/Server can settle to 'succeeded'.
      allow update: if isVerifiedUser() &&
        isValidId(intentId) &&
        isValidPaymentIntent(incoming()) &&
        incoming().intentId == existing().intentId &&
        incoming().ownerId == existing().ownerId &&
        incoming().idempotencyKey == existing().idempotencyKey &&
        incoming().planId == existing().planId &&
        incoming().billingCycle == existing().billingCycle &&
        incoming().amountTry == existing().amountTry &&
        incoming().currency == existing().currency &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (resource.data.ownerId == request.auth.uid &&
           existing().status == 'requires_3ds_authorization' &&
           incoming().status == 'cancelled' &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );

      allow delete: if false;
    }
  }
}
